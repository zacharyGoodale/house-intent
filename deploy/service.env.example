# systemd EnvironmentFile syntax. Private file; never commit real credentials.
HA_URL=http://127.0.0.1:8123
HA_JEV_BRIDGE_KEY=REPLACE_WITH_RANDOM_KEY_AT_LEAST_32_CHARACTERS
HA_TOKEN_LOCAL_USER=REPLACE_WITH_YOUR_HA_TOKEN
TYPESAFE_API_KEY=REPLACE_WITH_TYPESAFE_KEY
OPENAI_API_KEY=REPLACE_WITH_OPENAI_KEY
# Keep Luna by default. See HA integration guide before enabling Hermes.
HA_JEV_FALLBACK=luna
# HERMES_API_KEY=...
# HERMES_BASE_URL=https://hermes.example.test/v1
